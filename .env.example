# Copia este archivo a .env y ajusta los valores antes de ejecutar docker compose.

# Base de datos PostgreSQL
POSTGRES_DB=bodega_db
POSTGRES_USER=<USUARIO>
POSTGRES_PASSWORD=<PASSWORD>

# Hosts permitidos por la aplicacion web (incluye dominios de ngrok para demos)
ALLOWED_HOSTS=localhost;127.0.0.1;*.ngrok-free.dev;*.ngrok-free.app;*.ngrok.io

# Usuario administrador inicial (seed). La app lo crea o sincroniza su contrasena al arrancar.
SEED_ADMIN_EMAIL=admin@bodega.com
SEED_ADMIN_PASSWORD=<PASSWORD_ADMIN>
