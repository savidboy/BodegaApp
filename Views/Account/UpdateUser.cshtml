@model BodegaApp.DTOs.Account.AccountUserDTO

@{
    ViewData["Title"] = "Mis datos";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6">
            <div class="card">
                <div class="card-body p-4">
                    <h1 class="h4 text-primary mb-3">Mis datos</h1>

                    <form asp-action="UpdateUser" method="post">
                        <input asp-for="Id" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label">Nombre completo</label>
                            <input asp-for="FullName" class="form-control" autocomplete="name" autofocus />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Correo electrónico</label>
                            <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                            <div class="form-text">Si lo cambias, ese será tu usuario para iniciar sesión.</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Guardar cambios</button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
