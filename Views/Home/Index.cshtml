@{
    ViewData["Title"] = "Panel Principal";
}

<div class="hero p-4 p-md-5 mb-4">
    <h1 class="h3 mb-2">Sistema de Bodega</h1>
    <p class="text-muted mb-0" style="max-width: 65ch;">
        Bienvenido al sistema de administración y control de inventario. Desde aquí podrás gestionar
        productos, pedidos y usuarios.
    </p>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="module-card p-4">
            <h5>Inventario</h5>
            <p class="text-muted">Consulta de existencias, alta de nuevos productos y control de stock.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="module-card p-4">
            <h5>Pedidos</h5>
            <p class="text-muted">Registro y seguimiento de salidas, compras y recepción de mercadería.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="module-card p-4">
            <h5>Usuarios</h5>
            <p class="text-muted">Administración de accesos, roles y cuentas del personal autorizado.</p>
        </div>
    </div>
</div>
