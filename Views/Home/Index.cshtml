@{
    ViewData["Title"] = "Inicio";
}

<div class="hero p-4 p-md-5 mb-4">
    <h1 class="h3 mb-2">BodegaApp</h1>
    <p class="text-muted mb-0 prose-measure">
        Control de proveedores de la bodega: uvas, insumos, barricas, botellas, corchos y etiquetas.
    </p>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="module-card p-4">
            <h5>Proveedores</h5>
            <p class="text-muted">
                Alta, edición, búsqueda y baja de proveedores, con baja definitiva solo para el administrador.
            </p>
            <a asp-controller="Suppliers" asp-action="Index" class="btn btn-primary btn-sm">Abrir</a>
        </div>
    </div>

    <div class="col-md-6">
        <div class="module-card p-4">
            <h5>Pendiente</h5>
            <p class="text-muted">
                Inventario, pedidos y gestión de usuarios quedan para las siguientes entregas.
            </p>
        </div>
    </div>
</div>
