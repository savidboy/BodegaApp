@model BodegaApp.Domain.Entities.Proveedor

@{
    ViewData["Title"] = "Eliminar Proveedor";
}

<div class="container mt-4">
    <h1 class="text-danger">Eliminar Proveedor</h1>
    <h3 class="lead">¿Está seguro de que desea eliminar este proveedor?</h3>

    <div class="card mt-3 border-danger">
        <div class="card-body">
            <h4 class="card-title text-danger">@Model.Nombre</h4>

            <p><strong>Contacto:</strong> @Model.Contacto</p>
            <p><strong>Tipo:</strong> @Model.Tipo</p>
            <p><strong>Teléfono:</strong> @Model.Telefono</p>
            <p><strong>Email:</strong> @Model.Email</p>
            <p><strong>Dirección:</strong> @Model.Direccion</p>

            <form asp-action="Delete" method="post" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Eliminar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>

