@model BodegaApp.Domain.Entities.Proveedor

@{
    ViewData["Title"] = "Detalle del proveedor";
}

<div class="container mt-4">
    <h1>Detalle del proveedor</h1>

    <div class="card mt-3">
        <div class="card-body">
            <h4 class="card-title">@Model.Nombre</h4>

            <p><strong>Contacto:</strong> @Model.Contacto</p>
            <p><strong>Tipo:</strong> @Model.Tipo</p>
            <p><strong>Teléfono:</strong> @Model.Telefono</p>
            <p><strong>Email:</strong> @Model.Email</p>
            <p><strong>Dirección:</strong> @Model.Direccion</p>

            <p>
                <strong>Estado:</strong>

                @if (Model.Activo)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactivo</span>
                }
            </p>

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                Editar
            </a>

            <a asp-action="Index" class="btn btn-secondary">
                Volver
            </a>
        </div>
    </div>
</div>