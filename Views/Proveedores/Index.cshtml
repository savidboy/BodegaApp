@model IEnumerable<BodegaApp.Domain.Entities.Proveedor>

@{
    ViewData["Title"] = "Proveedores";
    var incluirInactivos = (bool)(ViewData["IncluirInactivos"] ?? false);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Proveedores</h1>

        <div class="d-flex gap-2 align-items-center">
            <a asp-action="Index"
               asp-route-incluirInactivos="@(!incluirInactivos)"
               class="btn btn-outline-secondary btn-sm">
                @(incluirInactivos ? "Ocultar inactivos" : "Ver inactivos")
            </a>

            <a asp-controller="Proveedores" asp-action="Create" class="btn btn-primary">
                Nuevo Proveedor
            </a>
        </div>
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Contacto</th>
                <th>Tipo</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var proveedor in Model)
            {
                <tr class="@(proveedor.Activo ? "" : "table-secondary opacity-75")">
                    <td>@proveedor.Nombre</td>
                    <td>@proveedor.Contacto</td>
                    <td>
                        <span class="badge bg-info">
                            @proveedor.Tipo
                        </span>
                    </td>
                    <td>@proveedor.Telefono</td>
                    <td>@proveedor.Email</td>
                    <td>
                        @if (proveedor.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@proveedor.Id" class="btn btn-sm btn-info">
                            Ver
                        </a>

                        <a asp-action="Edit" asp-route-id="@proveedor.Id" class="btn btn-sm btn-warning">
                            Editar
                        </a>

                        @if (proveedor.Activo)
                        {
                            <a asp-action="Delete" asp-route-id="@proveedor.Id" class="btn btn-sm btn-danger">
                                Desactivar
                            </a>
                        }
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        No hay proveedores para mostrar.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>