@model RoleDTO

@{
    ViewData["Title"] = "Eliminar rol";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="page-title text-danger">Eliminar rol</h1>

            <div class="alert alert-warning mt-3">
                ¿Está seguro de que desea eliminar este rol? Solo se puede eliminar si ningún usuario lo tiene asignado.
            </div>

            <div class="card mt-3 border-danger">
                <div class="card-body">
                    <h4 class="card-title text-danger">@Model.Name</h4>

                    <p class="mb-0">
                        <strong>Permisos asignados:</strong> @Model.PermissionCount
                    </p>

                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-4">
                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-danger">Eliminar</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
