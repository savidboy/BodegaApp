@model RoleFormViewModel

@{
    ViewData["Title"] = "Editar rol";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="page-title">Editar permisos del rol</h1>

            <div class="card mt-3">
                <div class="card-body p-4">

                    <form asp-action="Edit"
                          asp-route-id="@Model.RoleId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="RoleId" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="RoleName" class="form-label">
                                Nombre del rol
                            </label>

                            <input asp-for="RoleName"
                                   class="form-control"
                                   readonly />
                        </div>

                        <h5>Permisos del rol</h5>

                        <p class="text-muted">
                            Marca o desmarca los permisos que tendrá este rol.
                        </p>

                        @foreach (var group in Model.Permissions.GroupBy(p => p.Module))
                        {
                            <div class="mb-3">
                                <h6 class="text-primary">@group.Key</h6>

                                @foreach (var permission in group)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="SelectedPermissionIds"
                                               value="@permission.Id"
                                               id="permission_@permission.Id"
                                               checked="@Model.SelectedPermissionIds.Contains(permission.Id)" />

                                        <label class="form-check-label"
                                               for="permission_@permission.Id">
                                            @permission.Description
                                        </label>
                                    </div>
                                }
                            </div>
                        }

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                Actualizar permisos
                            </button>

                            <a asp-action="Index" class="btn btn-secondary">
                                Cancelar
                            </a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
