@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Ocurrió un error.</h1>
<h2 class="text-danger">No se pudo procesar tu solicitud.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Código de error:</strong> <code>@Model.RequestId</code>
    </p>
}

<p class="text-muted small">
    Intenta de nuevo. Si el problema continúa, comparte el código de error con el equipo.
</p>
