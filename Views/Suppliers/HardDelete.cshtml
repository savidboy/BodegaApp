@model SupplierDTO

@{
    ViewData["Title"] = "Eliminar proveedor";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="page-title text-danger">Eliminar proveedor permanentemente</h1>

            <div class="alert alert-danger mt-3">
                <strong>Atención:</strong> esta acción borra el proveedor de la base de datos y no se puede deshacer.
            </div>

            <div class="card mt-3 border-danger">
                <div class="card-body">
                    <h4 class="card-title text-danger">@Model.Name</h4>

                    <p><strong>Contacto:</strong> @Model.Contact</p>
                    <p><strong>Tipo:</strong> @Model.Type</p>
                    <p><strong>Teléfono:</strong> @Model.Phone</p>
                    <p><strong>Correo:</strong> @Model.Email</p>
                    <p><strong>Dirección:</strong> @Model.Address</p>

                    <p>
                        <strong>Estado:</strong>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </p>

                    <form asp-action="HardDelete" asp-route-id="@Model.Id" method="post" class="mt-4">
                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-danger">Eliminar permanentemente</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
