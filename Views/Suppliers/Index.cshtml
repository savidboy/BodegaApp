@model IEnumerable<BodegaApp.Domain.Entities.Supplier>

@{
    ViewData["Title"] = "Proveedores";
    var includeInactive = (bool)(ViewData["IncludeInactive"] ?? false);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="page-title">Proveedores</h1>

        <div class="d-flex gap-2 align-items-center">
            <a asp-action="Index"
               asp-route-includeInactive="@(!includeInactive)"
               class="btn btn-outline-secondary btn-sm">
                @(includeInactive ? "Ocultar inactivos" : "Ver inactivos")
            </a>

            <a asp-controller="Suppliers" asp-action="Create" class="btn btn-primary">
                Nuevo Proveedor
            </a>
        </div>
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Contacto</th>
                <th>Tipo</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var supplier in Model)
            {
                <tr class="@(supplier.IsActive ? "" : "table-secondary opacity-75")">
                    <td>@supplier.Name</td>
                    <td>@supplier.Contact</td>
                    <td>
                        <span class="badge bg-info">
                            @supplier.Type
                        </span>
                    </td>
                    <td>@supplier.Phone</td>
                    <td>@supplier.Email</td>
                    <td>
                        @if (supplier.IsActive)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@supplier.Id" class="btn btn-sm btn-info">
                            Ver
                        </a>

                        <a asp-action="Edit" asp-route-id="@supplier.Id" class="btn btn-sm btn-warning">
                            Editar
                        </a>

                        @if (supplier.IsActive)
                        {
                            <a asp-action="Delete" asp-route-id="@supplier.Id" class="btn btn-sm btn-outline-secondary">
                                Desactivar
                            </a>
                        }

                        <a asp-action="HardDelete" asp-route-id="@supplier.Id" class="btn btn-sm btn-danger">
                            Eliminar
                        </a>
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        No hay proveedores para mostrar.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
