@model PaginationResponse<SupplierDTO>

@{
    ViewData["Title"] = "Proveedores";
    var isAdmin = User.IsInRole(Roles.Admin);
    var includeInactive = Model.RouteValues.GetValueOrDefault("includeInactive") == "true";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="page-title">Proveedores</h1>

        <div class="d-flex gap-2 align-items-center">
            @if (isAdmin)
            {
                <a asp-action="Index"
                   asp-route-includeInactive="@(!includeInactive)"
                   asp-route-filter="@Model.Filter"
                   class="btn btn-outline-secondary btn-sm">
                    @(includeInactive ? "Ocultar inactivos" : "Ver inactivos")
                </a>
            }

            <a asp-action="Create" class="btn btn-primary">Nuevo proveedor</a>
        </div>
    </div>

    <form asp-action="Index" method="get" class="row g-2 mb-3">
        <input type="hidden" name="includeInactive" value="@(includeInactive ? "true" : "false")" />

        <div class="col">
            <input name="filter" value="@Model.Filter" class="form-control"
                   placeholder="Buscar por nombre, contacto o correo" />
        </div>

        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Buscar</button>
        </div>
    </form>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Contacto</th>
                <th>Tipo</th>
                <th>Teléfono</th>
                <th>Correo</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var supplier in Model.List)
            {
                <tr class="@(supplier.IsActive ? string.Empty : "table-secondary opacity-75")">
                    <td>@supplier.Name</td>
                    <td>@supplier.Contact</td>
                    <td>
                        <span class="badge bg-info">@supplier.Type</span>
                    </td>
                    <td>@supplier.Phone</td>
                    <td>@supplier.Email</td>
                    <td>
                        @if (supplier.IsActive)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@supplier.Id" class="btn btn-sm btn-info">Ver</a>
                        <a asp-action="Edit" asp-route-id="@supplier.Id" class="btn btn-sm btn-warning">Editar</a>

                        @if (supplier.IsActive)
                        {
                            <a asp-action="Delete" asp-route-id="@supplier.Id" class="btn btn-sm btn-outline-secondary">
                                Desactivar
                            </a>
                        }

                        @if (isAdmin)
                        {
                            <a asp-action="HardDelete" asp-route-id="@supplier.Id" class="btn btn-sm btn-danger">
                                Eliminar
                            </a>
                        }
                    </td>
                </tr>
            }

            @if (Model.List.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        No hay proveedores para mostrar.
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.TotalCount > 0)
    {
        <div class="d-flex justify-content-between align-items-center">
            <small class="text-muted">
                @Model.TotalCount proveedor(es) · página @Model.CurrentPage de @Model.TotalPages
            </small>

            <partial name="_Pagination" model="Model" />
        </div>
    }
</div>
