@model IEnumerable<UserViewModel>

@inject BodegaApp.Services.Abstractions.IAccountService Account

@{
    ViewData["Title"] = "Usuarios";

    // Los botones se ocultan por comodidad; el controlador valida el permiso igual
    var canCreate = await Account.AccountUserIsAuthorizedAsync(Permissions.UsersCreate);
    var canUpdate = await Account.AccountUserIsAuthorizedAsync(Permissions.UsersUpdate);
    var canDelete = await Account.AccountUserIsAuthorizedAsync(Permissions.UsersDelete);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="page-title">Usuarios</h1>

        @if (canCreate)
        {
            <a asp-action="Create" class="btn btn-primary">Nuevo usuario</a>
        }
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Roles</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>
                        @if (user.Roles.Count == 0)
                        {
                            <span class="text-muted">Sin rol</span>
                        }
                        else
                        {
                            foreach (string role in user.Roles)
                            {
                                <span class="badge bg-secondary">@role</span>
                            }
                        }
                    </td>
                    <td class="text-end">
                        @if (canUpdate)
                        {
                            <a asp-action="Edit"
                               asp-route-id="@user.Id"
                               class="btn btn-sm btn-warning">
                                Editar
                            </a>
                        }

                        @if (canDelete)
                        {
                            <a asp-action="Delete"
                               asp-route-id="@user.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Eliminar
                            </a>
                        }
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">
                        No hay usuarios registrados.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
