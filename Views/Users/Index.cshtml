@model PaginationResponse<UserDTO>

@inject BodegaApp.Services.Abstractions.IAccountService Account

@{
    ViewData["Title"] = "Usuarios";

    // Los botones se ocultan por comodidad; el controlador valida el permiso igual
    var canCreate = await Account.AccountUserIsAuthorizedAsync(Permissions.UsersCreate);
    var canUpdate = await Account.AccountUserIsAuthorizedAsync(Permissions.UsersUpdate);
    var canDelete = await Account.AccountUserIsAuthorizedAsync(Permissions.UsersDelete);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="page-title">Usuarios</h1>

        @if (canCreate)
        {
            <a asp-action="Create" class="btn btn-primary">Nuevo usuario</a>
        }
    </div>

    <form asp-action="Index" method="get" class="d-flex flex-wrap gap-2 mb-3">
        <input type="search"
               name="filter"
               value="@Model.Filter"
               class="form-control flex-grow-1 filter-input"
               aria-label="Buscar usuarios"
               placeholder="Buscar por nombre o correo" />

        <input type="hidden" name="recordsPerPage" value="@Model.RecordsPerPage" />

        <button type="submit" class="btn btn-outline-secondary">Buscar</button>

        @if (!string.IsNullOrWhiteSpace(Model.Filter))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </form>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Roles</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (UserDTO user in Model.List)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>
                        @if (user.Roles.Count == 0)
                        {
                            <span class="text-muted">Sin rol</span>
                        }
                        else
                        {
                            foreach (string role in user.Roles)
                            {
                                <span class="badge bg-secondary">@role</span>
                            }
                        }
                    </td>
                    <td class="text-end">
                        @if (canUpdate)
                        {
                            <a asp-action="Edit"
                               asp-route-id="@user.Id"
                               class="btn btn-sm btn-warning">
                                Editar
                            </a>
                        }

                        @if (canDelete)
                        {
                            <a asp-action="Delete"
                               asp-route-id="@user.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Eliminar
                            </a>
                        }
                    </td>
                </tr>
            }

            @if (Model.List.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">
                        @(string.IsNullOrWhiteSpace(Model.Filter)
                            ? "No hay usuarios registrados."
                            : "No hay usuarios que coincidan con la búsqueda.")
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <partial name="_Pagination" model="Model" />
</div>
