@model IEnumerable<BodegaApp.DTOs.User.UserViewModel>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container mt-4">
    <h2>Gestión de Usuarios</h2>
    <p>
        <a asp-action="Create" class="btn btn-primary">Nuevo Usuario</a>
    </p>
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Correo</th>
                <th>Rol</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Email</td>
                    <td><span class="badge bg-secondary">@item.Role</span></td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('¿Desea eliminar este usuario?');">
                            <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>